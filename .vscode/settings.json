{
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "env": {
                "PROJECT_BASE": "${workspaceFolder}",
                "PROJECT_NAME": ""
            }
        }
    },
    "asm-code-lens.assembler": "nasm (x86)",
    "files.associations": {
        "*.{asm,inc,s,nasm,yasm}": "asm-x86-nasm"
    }
}